<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Interested Signups</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { primary: "#C19A5B" } } } };
  </script>
  <style>
    .table-container {
      max-height: calc(100vh - 400px);
      overflow-y: auto;
    }
    .sticky-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: white;
    }
  </style>
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900">
  <header class="border-b border-neutral-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-6">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-sm font-semibold tracking-wide text-neutral-600">Nepa Rudraksha</div>
          <h1 class="mt-1 text-2xl font-semibold">Interested Signups</h1>
          <p class="mt-1 text-sm text-neutral-600">
            Total: <span class="font-semibold text-primary"><%= total %></span> signups
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a href="/admin" class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50">
            Back to Dashboard
          </a>
          <a
            href="/admin/interested-signups.csv<%= Object.keys(query).length > 0 ? '?' + new URLSearchParams(query).toString() : '' %>"
            class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50"
          >
            Export CSV
          </a>
          <form method="POST" action="/admin/logout">
            <button type="submit" class="rounded-xl bg-black px-4 py-2 text-sm font-semibold text-white hover:opacity-95">
              Logout
            </button>
          </form>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8">
    <% if (!rows || rows.length === 0) { %>
      <div class="rounded-2xl border border-neutral-200 bg-white p-12 text-center shadow-sm">
        <svg class="mx-auto h-16 w-16 text-neutral-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-neutral-900 mb-2">No Signups Found</h3>
        <p class="text-neutral-600">
          <% if (search || dateFrom || dateTo || filterSource || filterCountry) { %>
            Try adjusting your filters to see more results.
          <% } else { %>
            No signups have been recorded yet.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <!-- Filters Section -->
      <div class="mb-6 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <form method="GET" action="/admin/interested-signups" class="space-y-4">
          <div class="grid gap-4 md:grid-cols-3">
            <!-- Search -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Search</label>
              <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Search email or source..."
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              />
            </div>

            <!-- Date From -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Date From</label>
              <input
                type="date"
                name="date_from"
                value="<%= dateFrom || '' %>"
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              />
            </div>

            <!-- Date To -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Date To</label>
              <input
                type="date"
                name="date_to"
                value="<%= dateTo || '' %>"
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              />
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <!-- Source Filter -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Source</label>
              <select
                name="filter_source"
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              >
                <option value="">All Sources</option>
                <% sources.forEach(function(source) { %>
                  <option value="<%= source %>" <%= filterSource === source ? 'selected' : '' %>><%= source %></option>
                <% }); %>
              </select>
            </div>

            <!-- Country Filter -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Country Code</label>
              <select
                name="filter_country"
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              >
                <option value="">All Countries</option>
                <% countries.forEach(function(country) { %>
                  <option value="<%= country %>" <%= filterCountry === country ? 'selected' : '' %>><%= country %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="submit"
              class="rounded-xl bg-primary px-5 py-2 text-sm font-semibold text-white hover:opacity-95"
            >
              Apply Filters
            </button>
            <% if (search || dateFrom || dateTo || filterSource || filterCountry) { %>
              <a
                href="/admin/interested-signups"
                class="rounded-xl border border-neutral-300 bg-white px-5 py-2 text-sm font-semibold hover:bg-neutral-50"
              >
                Clear Filters
              </a>
            <% } %>
            <input type="hidden" name="per" value="<%= perPage %>" />
          </div>
        </form>
      </div>

      <!-- Table Section -->
      <div class="rounded-2xl border border-neutral-200 bg-white shadow-sm overflow-hidden">
        <div class="table-container overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="sticky-header border-b-2 border-primary/20">
              <tr class="bg-gradient-to-r from-neutral-50 to-white">
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-16">#</th>
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-32">Date</th>
                <th class="px-4 py-4 font-bold text-neutral-900 min-w-[200px]">Email</th>
                <th class="px-4 py-4 font-bold text-neutral-900 min-w-[150px]">Source</th>
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-24">Country</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
              <% rows.forEach(function(row) { %>
                <tr class="hover:bg-primary/5 transition-colors">
                  <td class="px-4 py-4 whitespace-nowrap">
                    <span class="text-xs font-semibold text-neutral-500">#<%= row.id %></span>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <div class="text-xs text-neutral-600">
                      <%= new Date(row.created_at).toLocaleDateString() %>
                    </div>
                    <div class="text-xs text-neutral-400">
                      <%= new Date(row.created_at).toLocaleTimeString() %>
                    </div>
                  </td>
                  <td class="px-4 py-4">
                    <div class="max-w-[200px] break-words">
                      <a href="mailto:<%= row.email %>" class="text-sm text-primary hover:underline font-medium">
                        <%= row.email %>
                      </a>
                    </div>
                  </td>
                  <td class="px-4 py-4">
                    <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                      <%= row.source || '-' %>
                    </span>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <span class="text-sm font-mono text-neutral-700"><%= row.country_code || '-' %></span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="flex items-center justify-between border-t border-neutral-200 bg-neutral-50 px-6 py-4">
          <div class="flex items-center gap-4">
            <div class="text-sm text-neutral-600">
              Showing <span class="font-semibold text-neutral-900"><%= Math.min((page - 1) * perPage + 1, total) %></span>
              to <span class="font-semibold text-neutral-900"><%= Math.min(page * perPage, total) %></span>
              of <span class="font-semibold text-primary"><%= total %></span> signups
            </div>
            <select
              id="perPageSelect"
              class="rounded-lg border border-neutral-300 bg-white px-3 py-1 text-sm"
              onchange="window.location.href = updateQueryParam('per', this.value)"
            >
              <option value="25" <%= perPage === 25 ? 'selected' : '' %>>25 per page</option>
              <option value="50" <%= perPage === 50 ? 'selected' : '' %>>50 per page</option>
              <option value="100" <%= perPage === 100 ? 'selected' : '' %>>100 per page</option>
              <option value="200" <%= perPage === 200 ? 'selected' : '' %>>200 per page</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <% const queryParams = new URLSearchParams(query); queryParams.delete('page'); %>
            <% const baseUrl = `/admin/interested-signups?${queryParams.toString()}`; %>

            <a
              class="rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50 <%= page <= 1 ? 'pointer-events-none opacity-50' : '' %>"
              href="<%= baseUrl %>&page=<%= Math.max(1, page - 1) %>"
            >
              ← Prev
            </a>

            <div class="flex items-center gap-1">
              <% 
                let startPage = Math.max(1, page - 2);
                let endPage = Math.min(totalPages, page + 2);
                if (startPage > 1) {
              %>
                <a href="<%= baseUrl %>&page=1" class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">1</a>
                <% if (startPage > 2) { %>
                  <span class="px-2 text-sm text-neutral-400">...</span>
                <% } %>
              <% } %>
              <% for (let p = startPage; p <= endPage; p++) { %>
                <a
                  href="<%= baseUrl %>&page=<%= p %>"
                  class="px-3 py-1.5 text-sm font-semibold rounded-lg <%= p === page ? 'bg-primary text-white' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100' %>"
                >
                  <%= p %>
                </a>
              <% } %>
              <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %>
                  <span class="px-2 text-sm text-neutral-400">...</span>
                <% } %>
                <a href="<%= baseUrl %>&page=<%= totalPages %>" class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900"><%= totalPages %></a>
              <% } %>
            </div>

            <a
              class="rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50 <%= page >= totalPages ? 'pointer-events-none opacity-50' : '' %>"
              href="<%= baseUrl %>&page=<%= Math.min(totalPages, page + 1) %>"
            >
              Next →
            </a>
          </div>
        </div>
      </div>
    <% } %>
  </main>

  <script>
    function updateQueryParam(key, value) {
      const url = new URL(window.location.href);
      url.searchParams.set(key, value);
      url.searchParams.set('page', '1'); // Reset to first page when changing per page
      return url.toString();
    }
  </script>
</body>
</html>
