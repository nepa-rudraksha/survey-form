<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Form Not Found</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 flex items-center justify-center p-6">
    <div class="max-w-lg w-full rounded-2xl border border-neutral-200 bg-white p-8 text-center shadow-sm">
      <h1 class="text-2xl font-semibold text-neutral-900">Form Not Found</h1>
      <p class="mt-2 text-neutral-600">
        The form you're looking for doesn't exist or is no longer available.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex rounded-xl bg-primary px-5 py-3 font-semibold text-white hover:opacity-95"
      >
        Go to Homepage
      </a>
    </div>
  </body>
</html>
