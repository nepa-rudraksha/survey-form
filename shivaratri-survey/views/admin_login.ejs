<!-- views/admin_login.ejs -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900">
  <main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-12">
    <div class="w-full rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
      <div class="mb-6">
        <div class="text-sm font-semibold tracking-wide text-neutral-600">Nepa Rudraksha</div>
        <h1 class="mt-2 text-2xl font-semibold">Admin Login</h1>
        <p class="mt-1 text-sm text-neutral-600">Enter your credentials to access survey responses.</p>
      </div>

      <% if (error) { %>
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/admin/login" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-neutral-800">Username</label>
          <input name="username" required
            class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[#C19A5B]/40"
            placeholder="Enter username" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-neutral-800">Password</label>
          <input name="password" type="password" required
            class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[#C19A5B]/40"
            placeholder="Enter password" />
        </div>

        <button type="submit"
          class="w-full rounded-xl bg-[#C19A5B] px-5 py-3 text-sm font-semibold text-white shadow-sm hover:opacity-95">
          Sign in
        </button>
      </form>
    </div>
  </main>
</body>
</html>
