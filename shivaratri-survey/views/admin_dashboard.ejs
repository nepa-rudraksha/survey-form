<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { primary: "#C19A5B" } } } };
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .card-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-hover:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-neutral-50 via-white to-neutral-50 text-neutral-900">
  <header class="border-b border-neutral-200 bg-white shadow-sm">
    <div class="mx-auto max-w-7xl px-4 py-6">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-sm font-semibold tracking-wide text-neutral-600">Nepa Rudraksha</div>
          <h1 class="mt-1 text-3xl font-bold text-neutral-900">Admin Dashboard</h1>
          <p class="mt-1 text-sm text-neutral-600">Manage forms, responses, and analytics</p>
        </div>
        <form method="POST" action="/admin/logout">
          <button type="submit" class="rounded-xl bg-black px-5 py-2 text-sm font-semibold text-white hover:opacity-95">
            Logout
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8">
    <!-- Quick Stats -->
    <div class="grid gap-4 md:grid-cols-4 mb-8">
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-neutral-600 uppercase tracking-wide">Total Forms</p>
            <p class="mt-2 text-3xl font-bold text-neutral-900"><%= stats.totalForms %></p>
            <p class="mt-1 text-xs text-neutral-500"><%= stats.publishedForms %> published</p>
          </div>
          <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center">
            <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-neutral-600 uppercase tracking-wide">Total Responses</p>
            <p class="mt-2 text-3xl font-bold text-primary"><%= stats.totalResponses %></p>
            <p class="mt-1 text-xs text-neutral-500">All forms</p>
          </div>
          <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center">
            <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-neutral-600 uppercase tracking-wide">Last 7 Days</p>
            <p class="mt-2 text-3xl font-bold text-neutral-900"><%= stats.last7Days %></p>
            <p class="mt-1 text-xs text-neutral-500">New responses</p>
          </div>
          <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center">
            <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-neutral-600 uppercase tracking-wide">Draft Forms</p>
            <p class="mt-2 text-3xl font-bold text-neutral-900"><%= stats.draftForms %></p>
            <p class="mt-1 text-xs text-neutral-500">Not published</p>
          </div>
          <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center">
            <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Actions -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-8">
      <!-- Forms Management -->
      <a href="/admin/forms" class="card-hover group block rounded-2xl border-2 border-primary/30 bg-white p-6 shadow-sm hover:border-primary/50">
        <div class="flex items-start justify-between mb-4">
          <div class="h-14 w-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">Primary</span>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors">Forms Management</h3>
        <p class="text-sm text-neutral-600 mb-4">Create, edit, and manage all survey forms</p>
        <div class="flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          <span>Manage Forms</span>
          <svg class="ml-2 h-4 w-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>

      <!-- Create New Form -->
      <a href="/admin/forms/new" class="card-hover group block rounded-2xl border-2 border-neutral-200 bg-white p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-start justify-between mb-4">
          <div class="h-14 w-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors">Create New Form</h3>
        <p class="text-sm text-neutral-600 mb-4">Build a new survey form with custom fields and sections</p>
        <div class="flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          <span>Create Form</span>
          <svg class="ml-2 h-4 w-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>

      <!-- Dynamic Sections -->
      <a href="/admin/sections" class="card-hover group block rounded-2xl border-2 border-neutral-200 bg-white p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-start justify-between mb-4">
          <div class="h-14 w-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z" />
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors">Dynamic Sections</h3>
        <p class="text-sm text-neutral-600 mb-4">Manage homepage and form page sections with images, links, and buttons</p>
        <div class="flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          <span>Manage Sections</span>
          <svg class="ml-2 h-4 w-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>

      <!-- Legacy Responses -->
      <a href="/admin/responses" class="card-hover group block rounded-2xl border-2 border-neutral-200 bg-white p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-start justify-between mb-4">
          <div class="h-14 w-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-600">Legacy</span>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors">Legacy Responses</h3>
        <p class="text-sm text-neutral-600 mb-4">View responses from the original survey_responses table</p>
        <div class="flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          <span>View Responses</span>
          <svg class="ml-2 h-4 w-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>

      <!-- Legacy Report -->
      <a href="/admin/report" class="card-hover group block rounded-2xl border-2 border-neutral-200 bg-white p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-start justify-between mb-4">
          <div class="h-14 w-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-600">Legacy</span>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors">Legacy Analytics</h3>
        <p class="text-sm text-neutral-600 mb-4">View analytics and reports for legacy survey responses</p>
        <div class="flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          <span>View Report</span>
          <svg class="ml-2 h-4 w-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>

      <!-- Interested Signups -->
      <a href="/admin/interested-signups" class="card-hover group block rounded-2xl border-2 border-neutral-200 bg-white p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-start justify-between mb-4">
          <div class="h-14 w-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors">Interested Signups</h3>
        <p class="text-sm text-neutral-600 mb-4">View and manage people who signed up through the API</p>
        <div class="flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          <span>View Signups</span>
          <svg class="ml-2 h-4 w-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>
    </div>

    <!-- Recent Forms -->
    <% if (recentForms && recentForms.length > 0) { %>
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-neutral-900">Recent Forms</h2>
          <a href="/admin/forms" class="text-sm font-semibold text-primary hover:underline">View All</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <% recentForms.slice(0, 6).forEach(function(form) { %>
            <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-4 hover:border-primary/30 transition-colors">
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-semibold text-neutral-900 flex-1"><%= form.title %></h3>
                <span class="rounded-full px-2 py-1 text-xs font-semibold <%= form.status === 'published' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= form.status === 'published' ? 'Published' : 'Draft' %>
                </span>
              </div>
              <div class="text-xs text-neutral-600 mb-3 line-clamp-2">
                <%- form.description || 'No description' %>
              </div>
              <div class="flex items-center gap-2">
                <a href="/admin/forms/<%= form.id %>/responses" class="flex-1 rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold text-center hover:bg-neutral-50">
                  Responses (<%= form.response_count || 0 %>)
                </a>
                <a href="/admin/forms/<%= form.id %>/edit" class="flex-1 rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold text-center hover:bg-neutral-50">
                  Edit
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
