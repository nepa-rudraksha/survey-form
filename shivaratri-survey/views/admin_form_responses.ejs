<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Form Responses - <%= form.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { primary: "#C19A5B" } } } };
  </script>
  <style>
    .table-container {
      max-height: calc(100vh - 400px);
      overflow-y: auto;
    }
    .sticky-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: white;
    }
  </style>
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900">
  <header class="border-b border-neutral-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-6">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-sm font-semibold tracking-wide text-neutral-600">Nepa Rudraksha</div>
          <h1 class="mt-1 text-2xl font-semibold">Responses: <%= form.title %></h1>
          <p class="mt-1 text-sm text-neutral-600">
            Total: <span class="font-semibold text-primary"><%= total %></span> responses
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a href="/admin/forms/<%= form.id %>/report" class="rounded-xl border border-primary/30 bg-primary/5 px-4 py-2 text-sm font-semibold text-primary hover:bg-primary/10">
            View Report
          </a>
          <a href="/admin/forms" class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50">
            Back to Forms
          </a>
          <a
            href="/admin/forms/<%= form.id %>/responses.csv<%= Object.keys(query).length > 0 ? '?' + new URLSearchParams(query).toString() : '' %>"
            class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50"
          >
            Export CSV
          </a>
          <form method="POST" action="/admin/logout">
            <button type="submit" class="rounded-xl bg-black px-4 py-2 text-sm font-semibold text-white hover:opacity-95">
              Logout
            </button>
          </form>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8">
    <% if (!rows || rows.length === 0) { %>
      <div class="rounded-2xl border border-neutral-200 bg-white p-12 text-center shadow-sm">
        <svg class="mx-auto h-16 w-16 text-neutral-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-xl font-semibold text-neutral-900 mb-2">No Responses Found</h3>
        <p class="text-neutral-600">
          <% if (search || dateFrom || dateTo) { %>
            Try adjusting your filters to see more results.
          <% } else { %>
            No responses have been submitted yet for this form.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <!-- Filters Section -->
      <div class="mb-6 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <form method="GET" action="/admin/forms/<%= form.id %>/responses" class="space-y-4">
          <div class="grid gap-4 md:grid-cols-3">
            <!-- Search -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Search</label>
              <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Search in text fields..."
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              />
            </div>

            <!-- Date From -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Date From</label>
              <input
                type="date"
                name="date_from"
                value="<%= dateFrom || '' %>"
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              />
            </div>

            <!-- Date To -->
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-2">Date To</label>
              <input
                type="date"
                name="date_to"
                value="<%= dateTo || '' %>"
                class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
              />
            </div>
          </div>

          <!-- Field-specific filters -->
          <% 
            const filterableFields = fields.filter(f => ['dropdown', 'radio', 'scale'].includes(f.field_type));
            if (filterableFields.length > 0) {
          %>
            <div class="grid gap-4 md:grid-cols-3">
              <% filterableFields.slice(0, 3).forEach(function(field) { 
                   const options = filterOptions[field.field_key] || [];
              %>
                <div>
                  <label class="block text-xs font-semibold text-neutral-700 mb-2"><%= field.label %></label>
                  <select
                    name="filter_<%= field.field_key %>"
                    class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                  >
                    <option value="">All</option>
                    <% options.forEach(function(opt) { %>
                      <option value="<%= opt %>" <%= query['filter_' + field.field_key] === opt ? 'selected' : '' %>><%= opt %></option>
                    <% }); %>
                  </select>
                </div>
              <% }); %>
            </div>
          <% } %>

          <div class="flex items-center gap-3">
            <button
              type="submit"
              class="rounded-xl bg-primary px-5 py-2 text-sm font-semibold text-white hover:opacity-95"
            >
              Apply Filters
            </button>
            <% if (search || dateFrom || dateTo) { %>
              <a
                href="/admin/forms/<%= form.id %>/responses"
                class="rounded-xl border border-neutral-300 bg-white px-5 py-2 text-sm font-semibold hover:bg-neutral-50"
              >
                Clear Filters
              </a>
            <% } %>
            <input type="hidden" name="per" value="<%= perPage %>" />
          </div>
        </form>
      </div>

      <!-- Table Section -->
      <div class="rounded-2xl border border-neutral-200 bg-white shadow-sm overflow-hidden">
        <div class="table-container overflow-x-auto">
          <table class="min-w-full text-left text-sm table-fixed">
            <thead class="sticky-header border-b-2 border-primary/20">
              <tr class="bg-gradient-to-r from-neutral-50 to-white">
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-16">#</th>
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-32">Date</th>
                <% fields.forEach(function(field) { %>
                  <th class="px-4 py-4 font-bold text-neutral-900 min-w-[120px] max-w-[200px]">
                    <div class="break-words">
                      <%= field.label %>
                      <% if (field.required) { %>
                        <span class="text-red-500">*</span>
                      <% } %>
                    </div>
                  </th>
                <% }); %>
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-32">Source</th>
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-32">IP</th>
                <th class="px-4 py-4 font-bold text-neutral-900 whitespace-nowrap w-56">Location</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
              <% rows.forEach(function(row, idx) { %>
                <tr class="hover:bg-primary/5 transition-colors">
                  <td class="px-4 py-4 whitespace-nowrap">
                    <span class="text-xs font-semibold text-neutral-500">#<%= row.id %></span>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <div class="text-xs text-neutral-600">
                      <%= new Date(row.created_at).toLocaleDateString() %>
                    </div>
                    <div class="text-xs text-neutral-400">
                      <%= new Date(row.created_at).toLocaleTimeString() %>
                    </div>
                  </td>
                  <% fields.forEach(function(field) { %>
                    <td class="px-4 py-4">
                      <% 
                        const value = row.response_data_parsed[field.field_key];
                        let displayValue = value;
                        
                        if (field.field_type === 'checkbox' && Array.isArray(value)) {
                          displayValue = value.length > 0 ? value.join(', ') : '-';
                        } else if (!value || value === '') {
                          displayValue = '-';
                        }
                      %>
                      <div class="max-w-[200px] break-words">
                        <span class="text-sm text-neutral-900"><%= displayValue %></span>
                      </div>
                    </td>
                  <% }); %>
                  <td class="px-4 py-4">
                    <% if (row.utm_source || row.utm_medium) { %>
                      <div class="text-xs max-w-[120px] break-words">
                        <div class="font-semibold text-neutral-900 break-words"><%= row.utm_source || '-' %></div>
                        <div class="text-neutral-600 break-words"><%= row.utm_medium || '-' %></div>
                        <% if (row.utm_campaign) { %>
                          <div class="text-neutral-500 text-[10px] break-words"><%= row.utm_campaign %></div>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-xs text-neutral-400">-</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <span class="text-xs font-mono text-neutral-600 break-all"><%= row.ip_address || '-' %></span>
                  </td>
                  <td class="px-4 py-4">
                    <span class="text-sm text-neutral-800 break-words">
                      <%= row.location_label || '-' %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="flex items-center justify-between border-t border-neutral-200 bg-neutral-50 px-6 py-4">
          <div class="flex items-center gap-4">
            <div class="text-sm text-neutral-600">
              Showing <span class="font-semibold text-neutral-900"><%= Math.min((page - 1) * perPage + 1, total) %></span>
              to <span class="font-semibold text-neutral-900"><%= Math.min(page * perPage, total) %></span>
              of <span class="font-semibold text-primary"><%= total %></span> responses
            </div>
            <select
              id="perPageSelect"
              class="rounded-lg border border-neutral-300 bg-white px-3 py-1 text-sm"
              onchange="window.location.href = updateQueryParam('per', this.value)"
            >
              <option value="25" <%= perPage === 25 ? 'selected' : '' %>>25 per page</option>
              <option value="50" <%= perPage === 50 ? 'selected' : '' %>>50 per page</option>
              <option value="100" <%= perPage === 100 ? 'selected' : '' %>>100 per page</option>
              <option value="200" <%= perPage === 200 ? 'selected' : '' %>>200 per page</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <% const totalPages = Math.max(1, Math.ceil(total / perPage)); %>
            <% const queryParams = new URLSearchParams(query); queryParams.delete('page'); %>
            <% const baseUrl = `/admin/forms/${form.id}/responses?${queryParams.toString()}`; %>

            <a
              class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50 <%= page <= 1 ? 'pointer-events-none opacity-50' : '' %>"
              href="<%= baseUrl %>&page=<%= Math.max(1, page - 1) %>"
            >
              ← Prev
            </a>

            <div class="flex items-center gap-1">
              <% 
                let startPage = Math.max(1, page - 2);
                let endPage = Math.min(totalPages, page + 2);
                if (startPage > 1) {
              %>
                <a href="<%= baseUrl %>&page=1" class="px-3 py-2 text-sm text-neutral-600 hover:text-neutral-900">1</a>
                <% if (startPage > 2) { %>
                  <span class="px-2 text-sm text-neutral-400">...</span>
                <% } %>
              <% } %>
              <% for (let p = startPage; p <= endPage; p++) { %>
                <a
                  href="<%= baseUrl %>&page=<%= p %>"
                  class="px-3 py-2 text-sm font-semibold rounded-lg <%= p === page ? 'bg-primary text-white' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100' %>"
                >
                  <%= p %>
                </a>
              <% } %>
              <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %>
                  <span class="px-2 text-sm text-neutral-400">...</span>
                <% } %>
                <a href="<%= baseUrl %>&page=<%= totalPages %>" class="px-3 py-2 text-sm text-neutral-600 hover:text-neutral-900"><%= totalPages %></a>
              <% } %>
            </div>

            <a
              class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50 <%= page >= totalPages ? 'pointer-events-none opacity-50' : '' %>"
              href="<%= baseUrl %>&page=<%= Math.min(totalPages, page + 1) %>"
            >
              Next →
            </a>
          </div>
        </div>
      </div>
    <% } %>
  </main>

  <script>
    function updateQueryParam(key, value) {
      const url = new URL(window.location);
      url.searchParams.set(key, value);
      url.searchParams.set('page', '1'); // Reset to first page when changing per page
      return url.toString();
    }
  </script>
</body>
</html>
