<!-- views/survey.ejs -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maha Shivaratri 2026 — Survey</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: { extend: { colors: { primary: "#C19A5B" } } },
      };
    </script>
  </head>

  <body class="min-h-screen bg-neutral-50 text-neutral-900 overflow-x-hidden">
    <!-- TOP HEADER (ADDED) -->
    <header class="border-b border-neutral-200 bg-white">
      <div
        class="mx-auto max-w-full px-4 py-6 md:px-6 md:py-10 flex justify-center"
        style="
          background:
            radial-gradient(900px circle at 15% 10%, rgba(193,154,91,.18), transparent 58%),
            radial-gradient(800px circle at 85% 0%, rgba(193,154,91,.12), transparent 60%),
            linear-gradient(180deg, #ffffff, #fafafa);
        "
      >
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between md:gap-6 min-w-0">
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-wider text-neutral-600">Nepa Rudraksha presents</p>
            <h2 class="mt-2 text-1xl md:text-2xl font-semibold tracking-tight leading-tight">
               Maha Shivaratri 2026
            </h2>

            <h1 class="mt-2 text-2xl md:text-3xl font-semibold tracking-tight leading-tight">
               Secrets of Rudraksha — Bangalore (In - Person Event)
            </h1>

            <p class="mt-2 text-sm md:text-base text-neutral-600 leading-relaxed">
              Bangalore Exhibition with Sukritya Khatiwada • Rare Rudraksha Display • Free 1:1 Consultation
            </p>
          </div>

          <div class="w-full md:w-auto md:shrink-0">
            <div class="rounded-2xl border border-primary/30 bg-white px-5 py-4 shadow-sm">
              <p class="text-sm font-semibold text-primary">📍 Bangalore, India</p>
              <p class="text-sm font-semibold text-primary">🗓 Feb 14, 2026 (Saturday | Eve of Shivaratri)</p>
              <p class="mt-1 text-sm text-neutral-600">This survey helps us plan with care.</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl px-4 py-8 pb-[calc(env(safe-area-inset-bottom)+7rem)]">
      <div class="w-full max-w-full rounded-2xl border border-neutral-200 bg-white shadow-sm overflow-hidden">
        <div class="p-5 md:p-8">
         
          <!-- MODE TOGGLE -->
          <div class="mt-8 flex flex-col gap-3 rounded-2xl border border-neutral-200 bg-neutral-50 p-4 md:flex-row md:items-center md:justify-between">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-neutral-900">
                <%= pageMode === 'edit' ? 'Update your response' : 'Form layout' %>
              </p>
              <p class="text-xs text-neutral-600 break-words">
                Choose a step-by-step experience or fill everything on a single page.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <button type="button" id="modeStep" class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-900 shadow-sm hover:bg-neutral-50">
                Step-by-step
              </button>
              <button type="button" id="modeSingle" class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-900 shadow-sm hover:bg-neutral-50">
                Single page
              </button>
            </div>
          </div>

          <!-- PROGRESS -->
          <div id="wizardProgress" class="mt-6 hidden">
            <div class="flex items-center justify-between min-w-0 gap-3">
              <p class="text-sm font-semibold text-neutral-900">Progress</p>
              <p id="progressText" class="text-sm text-neutral-600 shrink-0"></p>
            </div>
            <div class="mt-2 h-2 w-full rounded-full bg-neutral-100">
              <div id="progressBar" class="h-2 rounded-full bg-primary" style="width: 0%"></div>
            </div>
          </div>

          <form action="<%= pageMode === 'edit' ? ('/update/' + editKey) : '/submit' %>" method="POST" class="mt-8 space-y-10" id="surveyForm">
            <input type="hidden" name="utm_source" id="utm_source" value="<%= values.utm_source || '' %>" />
            <input type="hidden" name="utm_medium" id="utm_medium" value="<%= values.utm_medium || '' %>" />
            <input type="hidden" name="utm_campaign" id="utm_campaign" value="<%= values.utm_campaign || '' %>" />
            <input type="hidden" name="referrer" id="referrer" value="<%= values.referrer || '' %>" />

            <!-- STEP 1 -->
            <section class="step-section" data-step="1">
              <div class="flex items-center justify-between gap-4 min-w-0">
                <h2 class="text-lg font-semibold text-neutral-900 min-w-0 break-words">Section 1 — Basic details</h2>
                <span class="step-badge hidden shrink-0 rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-700">Step 1</span>
              </div>

              <div class="mt-4 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-neutral-800">1. Full name</label>
                  <input name="full_name" value="<%= values.full_name || '' %>"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                    placeholder="Your full name" />
                  <% if (errors.full_name) { %><p class="mt-2 text-sm text-red-600"><%= errors.full_name %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">2. Mobile number</label>
                  <input name="mobile_number" value="<%= values.mobile_number || '' %>"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                    placeholder="e.g. +91..." />
                  <% if (errors.mobile_number) { %><p class="mt-2 text-sm text-red-600"><%= errors.mobile_number %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">3. Email address</label>
                  <input name="email" type="email" required inputmode="email" autocomplete="email"
                    value="<%= values.email || '' %>"
                    class="mt-2 w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:ring-4
                      <%= (errors && errors.email) ? 'border-red-300 focus:border-red-400 focus:ring-red-200/50' : 'border-neutral-300 focus:border-primary focus:ring-primary/15' %>"
                    placeholder="you@example.com" />
                  <% if (errors && errors.email) { %>
                    <div class="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
                      <span class="font-medium">Please check:</span> <%= errors.email %>
                    </div>
                  <% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">4. Are you currently based in Bangalore?</label>
                  <select name="based_in_bangalore"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="live" <%= values.based_in_bangalore==='live'?'selected':'' %>>Yes — I live in Bangalore</option>
                    <option value="travel" <%= values.based_in_bangalore==='travel'?'selected':'' %>>I will travel to Bangalore</option>
                    <option value="maybe" <%= values.based_in_bangalore==='maybe'?'selected':'' %>>Maybe</option>
                    <option value="no" <%= values.based_in_bangalore==='no'?'selected':'' %>>No</option>
                  </select>
                  <% if (errors.based_in_bangalore) { %><p class="mt-2 text-sm text-red-600"><%= errors.based_in_bangalore %></p><% } %>
                </div>
              </div>
            </section>

            <!-- STEP 2 (Merged: Section 2 + 3) -->
            <section class="step-section" data-step="2">
              <div class="flex items-center justify-between gap-4 min-w-0">
                <h2 class="text-lg font-semibold text-neutral-900 min-w-0 break-words">Section 2 — Purchase status & Attendance</h2>
                <span class="step-badge hidden shrink-0 rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-700">Step 2</span>
              </div>

              <div class="mt-4 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-neutral-800">5. Have you purchased Rudraksha from Nepa Rudraksha?</label>
                  <select name="has_purchased"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="wearing" <%= values.has_purchased==='wearing'?'selected':'' %>>Yes — I am wearing currently</option>
                    <option value="not_wearing" <%= values.has_purchased==='not_wearing'?'selected':'' %>>Yes — not wearing currently</option>
                    <option value="plan_to" <%= values.has_purchased==='plan_to'?'selected':'' %>>No — but plan to purchase</option>
                    <option value="no" <%= values.has_purchased==='no'?'selected':'' %>>No</option>
                  </select>
                  <% if (errors.has_purchased) { %><p class="mt-2 text-sm text-red-600"><%= errors.has_purchased %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">6. If you currently wear Rudraksha, which one?</label>
                  <input name="currently_wear" value="<%= values.currently_wear || '' %>"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                    placeholder="Optional" />
                </div>
              </div>

              <div class="mt-6 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-neutral-800">7. Are you interested in attending?</label>
                  <select name="attending_interest"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="definitely" <%= values.attending_interest==='definitely'?'selected':'' %>>Definitely</option>
                    <option value="most_likely" <%= values.attending_interest==='most_likely'?'selected':'' %>>Most likely</option>
                    <option value="maybe_dates" <%= values.attending_interest==='maybe_dates'?'selected':'' %>>Maybe (depends on date/time)</option>
                    <option value="not_now" <%= values.attending_interest==='not_now'?'selected':'' %>>Not now</option>
                  </select>
                  <% if (errors.attending_interest) { %><p class="mt-2 text-sm text-red-600"><%= errors.attending_interest %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">8. Preferred timing on Feb 14</label>
                  <select name="feb14_timing"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="sat_morning" <%= values.feb14_timing==='sat_morning'?'selected':'' %>>Morning</option>
                    <option value="sat_evening" <%= values.feb14_timing==='sat_evening'?'selected':'' %>>Evening</option>
                  </select>
                  <% if (errors.feb14_timing) { %><p class="mt-2 text-sm text-red-600"><%= errors.feb14_timing %></p><% } %>
                </div>
              </div>
            </section>

            <!-- STEP 3 (Merged: Section 4 + 5 + 6) -->
            <section class="step-section" data-step="3">
              <div class="flex items-center justify-between gap-4 min-w-0">
                <h2 class="text-lg font-semibold text-neutral-900 min-w-0 break-words">Section 3 — Interests, Consultation & Add-ons</h2>
                <span class="step-badge hidden shrink-0 rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-700">Step 3</span>
              </div>

              <div class="mt-4">
                <label class="block text-sm font-medium text-neutral-800">9. Which experiences interest you? (select all that apply)</label>
                <div class="mt-3 grid gap-3 md:grid-cols-2">
                  <% const interests = values.event_interests || []; %>
                  <% const isChecked = (v) => Array.isArray(interests) && interests.includes(v); %>

                  <label class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4">
                    <input type="checkbox" name="event_interests" value="consultation" class="mt-1 accent-primary" <%= isChecked('consultation') ? 'checked' : '' %> />
                    <span class="text-sm text-neutral-800">Consultation</span>
                  </label>

                  <label class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4">
                    <input type="checkbox" name="event_interests" value="rare_exhibition" class="mt-1 accent-primary" <%= isChecked('rare_exhibition') ? 'checked' : '' %> />
                    <span class="text-sm text-neutral-800">Rare Rudraksha exhibition</span>
                  </label>

                  <label class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4">
                    <input type="checkbox" name="event_interests" value="book_launch" class="mt-1 accent-primary" <%= isChecked('book_launch') ? 'checked' : '' %> />
                    <span class="text-sm text-neutral-800">Launch of Sukritya’s upcoming book</span>
                  </label>

                  <label class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4">
                    <input type="checkbox" name="event_interests" value="shaligram_darshan" class="mt-1 accent-primary" <%= isChecked('shaligram_darshan') ? 'checked' : '' %> />
                    <span class="text-sm text-neutral-800">Rare Shaligram Darshan</span>
                  </label>
                </div>
                <% if (errors.event_interests) { %><p class="mt-2 text-sm text-red-600"><%= errors.event_interests %></p><% } %>
              </div>

              <div class="mt-6 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-neutral-800">10. Would you like a consultation?</label>
                  <select name="wants_consultation"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="yes" <%= values.wants_consultation==='yes'?'selected':'' %>>Yes</option>
                    <option value="maybe" <%= values.wants_consultation==='maybe'?'selected':'' %>>Maybe</option>
                    <option value="no" <%= values.wants_consultation==='no'?'selected':'' %>>No</option>
                  </select>
                  <% if (errors.wants_consultation) { %><p class="mt-2 text-sm text-red-600"><%= errors.wants_consultation %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">11. What type of Rudraksha interests you most?</label>
                  <select name="rudraksha_interest_type"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="healing_spiritual" <%= values.rudraksha_interest_type==='healing_spiritual'?'selected':'' %>>Healing / Spiritual growth</option>
                    <option value="planetary" <%= values.rudraksha_interest_type==='planetary'?'selected':'' %>>Planetary remedies</option>
                    <option value="siddha" <%= values.rudraksha_interest_type==='siddha'?'selected':'' %>>Siddha combinations</option>
                    <option value="rare" <%= values.rudraksha_interest_type==='rare'?'selected':'' %>>Rare collection</option>
                    <option value="family" <%= values.rudraksha_interest_type==='family'?'selected':'' %>>Family wellbeing</option>
                    <option value="not_sure" <%= values.rudraksha_interest_type==='not_sure'?'selected':'' %>>Not sure</option>
                  </select>
                  <% if (errors.rudraksha_interest_type) { %><p class="mt-2 text-sm text-red-600"><%= errors.rudraksha_interest_type %></p><% } %>
                </div>
              </div>

              <div class="mt-6 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-neutral-800">12. Would you like to reserve a signed book?</label>
                  <select name="reserve_signed_book"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="yes" <%= values.reserve_signed_book==='yes'?'selected':'' %>>Yes</option>
                    <option value="maybe" <%= values.reserve_signed_book==='maybe'?'selected':'' %>>Maybe</option>
                    <option value="no" <%= values.reserve_signed_book==='no'?'selected':'' %>>No</option>
                  </select>
                  <% if (errors.reserve_signed_book) { %><p class="mt-2 text-sm text-red-600"><%= errors.reserve_signed_book %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">13. Would you like Shaligram Darshan?</label>
                  <select name="shaligram_darshan"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="yes" <%= values.shaligram_darshan==='yes'?'selected':'' %>>Yes</option>
                    <option value="maybe" <%= values.shaligram_darshan==='maybe'?'selected':'' %>>Maybe</option>
                    <option value="no" <%= values.shaligram_darshan==='no'?'selected':'' %>>No</option>
                  </select>
                  <% if (errors.shaligram_darshan) { %><p class="mt-2 text-sm text-red-600"><%= errors.shaligram_darshan %></p><% } %>
                </div>
              </div>
            </section>

            <!-- STEP 4 (Merged: Section 7 + 8) -->
            <section class="step-section" data-step="4">
              <div class="flex items-center justify-between gap-4 min-w-0">
                <h2 class="text-lg font-semibold text-neutral-900 min-w-0 break-words">Section 4 — Personal input & Closing</h2>
                <span class="step-badge hidden shrink-0 rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-700">Step 4</span>
              </div>

              <div class="mt-4">
                <label class="block text-sm font-medium text-neutral-800">14. What is the biggest question you have about Rudraksha?</label>
                <textarea name="biggest_question" rows="4"
                  class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                  placeholder="Write your question here"><%= values.biggest_question || '' %></textarea>
                <% if (errors.biggest_question) { %><p class="mt-2 text-sm text-red-600"><%= errors.biggest_question %></p><% } %>
              </div>

              <div class="mt-4 grid gap-4 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-neutral-800">15. How did you first discover Nepa Rudraksha?</label>
                  <select name="discovered_from"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15">
                    <option value="">Select</option>
                    <option value="instagram" <%= values.discovered_from==='instagram'?'selected':'' %>>Instagram</option>
                    <option value="youtube" <%= values.discovered_from==='youtube'?'selected':'' %>>YouTube</option>
                    <option value="word_of_mouth" <%= values.discovered_from==='word_of_mouth'?'selected':'' %>>Word of mouth</option>
                    <option value="event_talk" <%= values.discovered_from==='event_talk'?'selected':'' %>>Event / Talk</option>
                    <option value="friend_family" <%= values.discovered_from==='friend_family'?'selected':'' %>>Friend / Family</option>
                    <option value="other" <%= values.discovered_from==='other'?'selected':'' %>>Other</option>
                  </select>
                  <% if (errors.discovered_from) { %><p class="mt-2 text-sm text-red-600"><%= errors.discovered_from %></p><% } %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-neutral-800">If other, please specify (optional)</label>
                  <input name="discovered_other" value="<%= values.discovered_other || '' %>"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                    placeholder="Type source" />
                </div>
              </div>

              <div class="mt-6">
                <label class="block text-sm font-medium text-neutral-800">16. Anything you’d like us to know or arrange for you during the event? (optional)</label>
                <textarea name="arrangement_notes" rows="4"
                  class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none focus:border-primary focus:ring-4 focus:ring-primary/15"
                  placeholder="Any preferences or notes"><%= values.arrangement_notes || '' %></textarea>
              </div>

              <div class="mt-4">
                <label class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4 min-w-0">
                  <input type="checkbox" name="wants_updates" class="mt-1 accent-primary shrink-0"
                    <%= (values.wants_updates === 'on' || values.wants_updates === 1 || values.wants_updates === '1' || values.wants_updates === true || values.wants_updates === undefined) ? 'checked' : '' %>
                  />
                  <span class="text-sm text-neutral-800 flex-1 min-w-0 break-words">I would like to receive updates and early invitations to future events</span>
                </label>
              </div>
            </section>

            <!-- ACTION BAR -->
            <div
              id="actionBar"
              class="sticky bottom-0 -mx-5 md:-mx-8 mt-6 border-t border-neutral-200 bg-white/95 backdrop-blur px-5 md:px-8 py-4"
              style="padding-bottom: calc(env(safe-area-inset-bottom) + 1rem);"
            >
              <div id="wizardNav" class="hidden">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <button
                    type="button"
                    id="btnBack"
                    class="w-full rounded-xl border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-neutral-900 shadow-sm hover:bg-neutral-50 sm:w-auto"
                  >
                    Back
                  </button>

                  <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <button type="button" id="btnNext" class="w-full rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white shadow-sm hover:opacity-95 sm:w-auto">
                      Next
                    </button>

                    <button type="submit" id="btnSubmitWizard" class="hidden w-full rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white shadow-sm hover:opacity-95 sm:w-auto">
                      <%= pageMode === 'edit' ? 'Update' : 'Submit' %>
                    </button>
                  </div>
                </div>

                <p class="mt-3 text-xs text-neutral-500">
                  Tip: You can switch to “Single page” if you prefer to review everything at once.
                </p>
              </div>

              <div id="singleSubmit" class="hidden">
                <button type="submit" class="w-full rounded-xl bg-primary px-5 py-4 text-sm font-semibold text-white shadow-sm hover:opacity-95">
                  <%= pageMode === 'edit' ? 'Update' : 'Submit' %>
                </button>
                <p class="mt-3 text-center text-xs text-neutral-500">
                  By submitting, you agree to be contacted by Nepa Rudraksha for event updates.
                </p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const setIfEmpty = (id, val) => {
          const el = document.getElementById(id);
          if (el && !el.value) el.value = val || "";
        };
        setIfEmpty("utm_source", params.get("utm_source"));
        setIfEmpty("utm_medium", params.get("utm_medium"));
        setIfEmpty("utm_campaign", params.get("utm_campaign"));
        setIfEmpty("referrer", document.referrer || "");

        let serverErrors = {};
        try { serverErrors = <%- JSON.stringify(errors || {}) %>; } catch { serverErrors = {}; }

        const sections = Array.from(document.querySelectorAll(".step-section"));
        const totalSteps = sections.length || 4;

        const modeStepBtn = document.getElementById("modeStep");
        const modeSingleBtn = document.getElementById("modeSingle");

        const wizardNav = document.getElementById("wizardNav");
        const singleSubmit = document.getElementById("singleSubmit");
        const wizardProgress = document.getElementById("wizardProgress");
        const progressBar = document.getElementById("progressBar");
        const progressText = document.getElementById("progressText");
        const btnBack = document.getElementById("btnBack");
        const btnNext = document.getElementById("btnNext");
        const btnSubmitWizard = document.getElementById("btnSubmitWizard");

        if (!wizardNav || !singleSubmit || sections.length === 0) {
          if (singleSubmit) singleSubmit.classList.remove("hidden");
          return;
        }

        const STORAGE_MODE = "nr_survey_mode";
        const STORAGE_STEP = "nr_survey_step";

        function scrollToActiveStep(activeEl, behavior = "smooth") {
          if (!activeEl) return;

          // small padding so the title isn't glued to the top
          const offset = 16;

          // wait a tick so display changes apply before measuring
          requestAnimationFrame(() => {
            const y = activeEl.getBoundingClientRect().top + window.scrollY - offset;
            window.scrollTo({ top: Math.max(0, y), behavior });
          });
        }


        function hasAnyErrors() {
          return serverErrors && Object.keys(serverErrors).length > 0;
        }

        function setActiveButton(mode) {
          const active = ["border-primary/50", "ring-4", "ring-primary/10", "text-primary"];
          const inactive = ["border-neutral-300", "text-neutral-900", "ring-0"];

          const apply = (btn, isActive) => {
            if (!btn) return;
            btn.classList.remove(...active, ...inactive);
            btn.classList.add(...(isActive ? active : inactive));
          };

          apply(modeStepBtn, mode === "wizard");
          apply(modeSingleBtn, mode === "single");
        }

        function updateProgress(step) {
          const pct = Math.round((step / totalSteps) * 100);
          if (progressBar) progressBar.style.width = pct + "%";
          if (progressText) progressText.textContent = "Step " + step + " of " + totalSteps;
        }

        function showWizard(step, opts = { scroll: true, behavior: "smooth" }) {
          sections.forEach((s) => (s.style.display = "none"));
          const active = sections.find((s) => Number(s.dataset.step) === step);
          if (active) active.style.display = "block";
        
          document.querySelectorAll(".step-badge").forEach((b) => b.classList.remove("hidden"));
        
          wizardNav.classList.remove("hidden");
          wizardProgress.classList.remove("hidden");
          singleSubmit.classList.add("hidden");
        
          if (btnBack) {
            btnBack.disabled = step === 1;
            btnBack.classList.toggle("opacity-50", step === 1);
            btnBack.classList.toggle("cursor-not-allowed", step === 1);
          }
      
          const isLast = step === totalSteps;
          if (btnNext) btnNext.classList.toggle("hidden", isLast);
          if (btnSubmitWizard) btnSubmitWizard.classList.toggle("hidden", !isLast);
      
          updateProgress(step);
          localStorage.setItem(STORAGE_STEP, String(step));
          localStorage.setItem(STORAGE_MODE, "wizard");
          setActiveButton("wizard");
      
          // ✅ scroll to the active step, not the top of the page
          if (opts?.scroll) scrollToActiveStep(active, opts.behavior || "smooth");
        }


        function showSingle() {
          sections.forEach((s) => (s.style.display = "block"));
          document.querySelectorAll(".step-badge").forEach((b) => b.classList.add("hidden"));

          wizardNav.classList.add("hidden");
          wizardProgress.classList.add("hidden");
          singleSubmit.classList.remove("hidden");

          localStorage.setItem(STORAGE_MODE, "single");
          setActiveButton("single");
        }

        modeStepBtn?.addEventListener("click", () => showWizard(1));
        modeSingleBtn?.addEventListener("click", () => showSingle());

        btnBack?.addEventListener("click", () => {
          const cur = Number(localStorage.getItem(STORAGE_STEP) || "1");
          showWizard(Math.max(1, cur - 1));
        });

        btnNext?.addEventListener("click", () => {
          const cur = Number(localStorage.getItem(STORAGE_STEP) || "1");
          showWizard(Math.min(totalSteps, cur + 1));
        });

        (function init() {
          if (hasAnyErrors()) {
            showSingle();
            return;
          }
          const savedMode = localStorage.getItem(STORAGE_MODE) || "wizard";
          if (savedMode === "single") {
            showSingle();
          } else {
            const savedStep = Number(localStorage.getItem(STORAGE_STEP) || "1");
            const step = Math.min(Math.max(savedStep, 1), totalSteps);
            showWizard(step);
          }
        })();
      });
    </script>
  </body>
</html>
