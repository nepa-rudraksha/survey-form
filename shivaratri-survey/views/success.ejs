<!-- views/success.ejs -->
<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Thank You</title>
    <%- include('partials/ga') %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = { theme: { extend: { colors: { primary: "#C19A5B" } } } };
    </script>
  </head>
  <script>
  (function () {
    const mobile = "<%= mobile_number %>";
    const editUrl = "<%= editUrl %>";

    try {
      const absoluteEditUrl = new URL(editUrl, window.location.origin).toString();
      localStorage.setItem("nr_edit_" + mobile, absoluteEditUrl);
    } catch (e) {
      // ignore storage errors (private mode / blocked storage)
    }
  })();
</script>

  <body class="min-h-screen bg-neutral-50 text-neutral-900 flex items-center justify-center p-6">
    <div class="max-w-lg w-full rounded-2xl border border-neutral-200 bg-white p-8 text-center shadow-sm">
      <h1 class="text-2xl font-semibold text-neutral-900">Thank you</h1>
      <p class="mt-2 text-neutral-600">
        Your response has been saved. We will reach out with Bangalore event updates soon.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex rounded-xl bg-primary px-5 py-3 font-semibold text-white hover:opacity-95"
      >
        Submit another response
      </a>
    </div>
  </body>
</html>
