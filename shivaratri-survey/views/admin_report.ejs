<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Survey Report</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { primary: "#C19A5B" } } } };
  </script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="min-h-screen bg-neutral-50 text-neutral-900">
  <header class="border-b border-neutral-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-6">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-sm font-semibold tracking-wide text-neutral-600">Nepa Rudraksha</div>
          <h1 class="mt-1 text-2xl font-semibold">Survey Analytics Report</h1>
          <p class="mt-1 text-sm text-neutral-600">A complete view of responses (charts + totals).</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a href="/admin/responses" class="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-neutral-50">
            View Responses Table
          </a>

          <form method="GET" action="/admin/report" class="flex items-center gap-2">
            <label class="text-sm text-neutral-600">Trend range</label>
            <select name="days" class="rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm">
              <% [30,60,90,180,365].forEach(function(n){ %>
                <option value="<%= n %>" <%= (String(days) === String(n)) ? 'selected' : '' %>><%= n %> days</option>
              <% }) %>
            </select>
            <button class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-95" type="submit">
              Apply
            </button>
          </form>

          <form method="POST" action="/admin/logout">
            <button type="submit" class="rounded-xl bg-black px-4 py-2 text-sm font-semibold text-white hover:opacity-95">
              Logout
            </button>
          </form>
        </div>
      </div>

      <!-- KPI cards -->
      <div class="mt-6 grid gap-3 md:grid-cols-4">
        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Total responses</div>
          <div class="mt-2 text-3xl font-semibold"><%= kpis.total %></div>
          <div class="mt-1 text-sm text-neutral-600">Last 7 days: <span class="font-semibold text-neutral-900"><%= kpis.last_7_days %></span></div>
          <div class="text-sm text-neutral-600">Last 30 days: <span class="font-semibold text-neutral-900"><%= kpis.last_30_days %></span></div>
        </div>

        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Wants updates</div>
          <div class="mt-2 text-3xl font-semibold"><%= kpis.updates_yes %></div>
          <div class="mt-1 text-sm text-neutral-600">Yes: <span class="font-semibold text-neutral-900"><%= kpis.updates_yes_pct %>%</span></div>
          <div class="text-sm text-neutral-600">No: <span class="font-semibold text-neutral-900"><%= kpis.updates_no %></span></div>
        </div>

        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Definitely attending</div>
          <div class="mt-2 text-3xl font-semibold"><%= kpis.definitely_count %></div>
          <div class="mt-1 text-sm text-neutral-600">Share: <span class="font-semibold text-neutral-900"><%= kpis.definitely_pct %>%</span></div>
        </div>

        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Consultation (Yes)</div>
          <div class="mt-2 text-3xl font-semibold"><%= kpis.consult_yes %></div>
          <div class="mt-1 text-sm text-neutral-600">Share: <span class="font-semibold text-neutral-900"><%= kpis.consult_yes_pct %>%</span></div>
        </div>
      </div>

      <div class="mt-3 grid gap-3 md:grid-cols-3">
        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Reserve signed book (Yes)</div>
          <div class="mt-2 text-2xl font-semibold"><%= kpis.signed_book_yes %> <span class="text-sm text-neutral-600 font-normal">(<%= kpis.signed_book_yes_pct %>%)</span></div>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Shaligram darshan (Yes)</div>
          <div class="mt-2 text-2xl font-semibold"><%= kpis.shaligram_yes %> <span class="text-sm text-neutral-600 font-normal">(<%= kpis.shaligram_yes_pct %>%)</span></div>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
          <div class="text-xs font-semibold text-neutral-600">Trend window</div>
          <div class="mt-2 text-2xl font-semibold"><%= days %> days</div>
          <div class="mt-1 text-sm text-neutral-600">Daily submissions chart uses this range.</div>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8 space-y-6">

    <!-- Daily trend -->
    <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">Daily submissions trend</h2>
        <div class="text-sm text-neutral-600">Last <%= days %> days</div>
      </div>
      <div class="mt-4">
        <canvas id="chartDaily" height="90"></canvas>
      </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Attendance interest</h2>
        <div class="mt-4"><canvas id="chartAttendance" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Preferred timing</h2>
        <div class="mt-4"><canvas id="chartTiming" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Consultation interest</h2>
        <div class="mt-4"><canvas id="chartConsultation" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Rudraksha interest type</h2>
        <div class="mt-4"><canvas id="chartInterestType" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Discovered from</h2>
        <div class="mt-4"><canvas id="chartDiscovered" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Bangalore status</h2>
        <div class="mt-4"><canvas id="chartBangalore" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Purchase status</h2>
        <div class="mt-4"><canvas id="chartPurchase" height="120"></canvas></div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold">Top event interests (from checkbox JSON)</h2>
        <div class="mt-4"><canvas id="chartEventInterests" height="120"></canvas></div>
      </section>
    </div>

  </main>

  <script>
    // Data injected from server
    const charts = <%- JSON.stringify(charts) %>;

    function barChart(canvasId, items, title) {
      const el = document.getElementById(canvasId);
      const labels = items.map(x => x.label ?? x.name ?? x.key);
      const data = items.map(x => x.count);

      new Chart(el, {
        type: "bar",
        data: {
          labels,
          datasets: [{ label: title, data }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false },
            tooltip: { enabled: true }
          },
          scales: {
            y: { beginAtZero: true }
          }
        }
      });
    }

    // Daily line
    (function () {
      const el = document.getElementById("chartDaily");
      const labels = charts.daily.map(x => x.date);
      const data = charts.daily.map(x => x.count);

      new Chart(el, {
        type: "line",
        data: {
          labels,
          datasets: [{ label: "Responses per day", data, tension: 0.25 }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    })();

    // Bars
    barChart("chartAttendance", charts.attendance, "Attendance");
    barChart("chartTiming", charts.timing, "Timing");
    barChart("chartConsultation", charts.consultation, "Consultation");
    barChart("chartInterestType", charts.interestType, "Interest Type");
    barChart("chartDiscovered", charts.discoveredFrom, "Discovered From");
    barChart("chartBangalore", charts.bangaloreStatus, "Bangalore Status");
    barChart("chartPurchase", charts.purchaseStatus, "Purchase Status");

    // Top event interests
    barChart(
      "chartEventInterests",
      charts.topEventInterests.map(x => ({ label: x.name, count: x.count })),
      "Top interests"
    );
  </script>
</body>
</html>
